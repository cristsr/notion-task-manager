{
  "name": "nexus",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nexus/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/nexus"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/nexus/package.json",
        "{workspaceRoot}/dist/apps/nexus/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/nexus/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "nexus:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "nexus:build:development"
        },
        "production": {
          "buildTarget": "nexus:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:production"],
      "options": {
        "commands": [
          "nx build nexus --configuration production",
          "docker build -f apps/nexus/Dockerfile -t nexus:latest ."
        ],
        "parallel": false
      }
    },
    "docker:run": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker:build"],
      "options": {
        "commands": [
          "nx docker:stop nexus",
          "docker run -d --name notion-nexus --restart always -p 3943:3943 nexus:latest"
        ],
        "parallel": false
      }
    },
    "docker:stop": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker stop notion-nexus 2>nul || exit /b 0",
          "docker rm notion-nexus 2>nul || exit /b 0"
        ],
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx docker:build nexus", "nx docker:run nexus"],
        "parallel": false
      }
    }
  }
}
